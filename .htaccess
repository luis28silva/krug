RewriteEngine On

# força https e www de uma vez
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.krugbiscoitos.com.br%{REQUEST_URI} [L,R=301]

# /index.html vira só /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]